{
  "author": "dwd",
  "name": "world-daylight-map",
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "NO-prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "module": "dist/world-daylight-map.esm.js",
  "size-limit": [
    {
      "path": "dist/world-daylight-map.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/world-daylight-map.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@types/d3": "^5.7.2",
    "@types/suncalc": "^1.8.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/topojson": "^3.2.2",
    "@size-limit/preset-small-lib": "^8.0.0",
    "husky": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^8.0.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.4.0",
    "typescript": "^3.9.10"
  },
  "dependencies": {
    "d3": "^7.6.1",
    "moment": "^2.29.4",
    "suncalc": "^1.9.0",
    "topojson": "^3.0.2"
  }
}
